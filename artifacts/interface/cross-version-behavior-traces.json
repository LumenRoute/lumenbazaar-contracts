{
  "schema": "lumenbazaar/cross-version-behavior-traces",
  "version": 1,
  "fromInterfaceVersion": 2,
  "toInterfaceVersion": 3,
  "sharedOperations": [
    "cancel",
    "create_session",
    "extend_ttl",
    "get_session",
    "initialize",
    "interface_version",
    "recover_expired",
    "settle"
  ],
  "identifierIsolationRule": "Session IDs are deployment-scoped (v2: legacy tuple hash; v3: domain-separated ScVal XDR hash with idempotency_key). Traces normalize session handles within each deployment and forbid cross-deployment identifier reinterpretation.",
  "expectedDifferences": [
    {
      "id": "diff-interface-version",
      "operation": "interface_version",
      "field": "result",
      "v2Value": 2,
      "v3Value": 3,
      "rationale": "Each replacement deployment reports its frozen major interface version."
    },
    {
      "id": "diff-initialize-asset-policies-and-event",
      "operation": "initialize",
      "field": "events",
      "v2Value": [],
      "v3Value": [
        "AssetActivated"
      ],
      "rationale": "v2 records a boolean supported-asset flag with no event; v3 validates SEP-41 asset policies, sets AssetStatus::Active, and emits AssetActivated (event_version 3)."
    },
    {
      "id": "diff-create-session-domain-id",
      "operation": "create_session",
      "field": "session_id_scheme",
      "v2Value": "v2-flat-tuple-sha256",
      "v3Value": "v3-domain-separated-xdr-sha256",
      "rationale": "v3 session IDs hash domain-separated ScVal XDR (domain_xdr, payload_xdr) including idempotency_key; identifiers are deployment-scoped and never reinterpreted across contracts."
    },
    {
      "id": "diff-session-audit-metadata",
      "operation": "get_session",
      "field": "v3_only_session_fields",
      "v2Value": null,
      "v3Value": [
        "creation_ledger",
        "finalized_ledger",
        "resource_scheme_version",
        "usage_scheme_version"
      ],
      "rationale": "v3 appends audit ledger and commitment scheme version metadata to Session while preserving all shared v2 session fields, status transitions, events, and balances."
    }
  ],
