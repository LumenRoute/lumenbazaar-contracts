STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_ACCOUNT=lumenbazaar-testnet-deployer

# Optional overrides. If omitted, scripts use STELLAR_ACCOUNT.
LUMENBAZAAR_SOURCE_ACCOUNT=lumenbazaar-testnet-deployer
LUMENBAZAAR_ADMIN=lumenbazaar-testnet-admin
LUMENBAZAAR_TEST_TOKEN_ADMIN=lumenbazaar-testnet-token-admin
LUMENBAZAAR_POLICY_OWNER=lumenbazaar-testnet-policy-owner

# Optional bounded RPC retry and timeout overrides (milliseconds / count).
# LUMENBAZAAR_RPC_MAX_ATTEMPTS=4
# LUMENBAZAAR_RPC_ATTEMPT_TIMEOUT_MS=15000
# LUMENBAZAAR_RPC_TOTAL_TIMEOUT_MS=45000
# LUMENBAZAAR_RPC_INITIAL_DELAY_MS=500
# LUMENBAZAAR_RPC_MAX_DELAY_MS=8000
